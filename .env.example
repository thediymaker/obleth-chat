# Connected Rust app. npm run start:api loads .env; direct Rust invocation
# uses exported variables. Keep your populated .env out of source control.
OBLETH_CHAT_ORIGIN=http://localhost:8085
OBLETH_CHAT_LISTEN=127.0.0.1:8085
OBLETH_CHAT_DATABASE_URL=postgresql://obleth_chat:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/obleth_chat

# Username/password is the default. Bootstrap only runs with an empty users table.
# Set a password of at least 12 characters; remove bootstrap credentials after setup.
OBLETH_CHAT_BOOTSTRAP_USERNAME=admin
OBLETH_CHAT_BOOTSTRAP_PASSWORD=

# Optional gateway: set BOTH URL and key file. URL must not include /v1.
# OBLETH_CHAT_GATEWAY_URL=http://localhost:8080
# OBLETH_CHAT_GATEWAY_SIGNING_KEY_FILE=/absolute/path/to/obleth-chat-signing.pem
# OBLETH_CHAT_GATEWAY_ISSUER=https://chat.example.edu
# OBLETH_CHAT_GATEWAY_AUDIENCE=obleth
# sign (default): Chat signs each gateway call with the key above.
# forward: calls carry the access token the OIDC provider issued to the signed-in
# person (see README "Forwarding provider tokens"). Needs OIDC with offline_access
# and OBLETH_CHAT_SECRET_KEY_FILE; the signing key becomes optional and then serves
# only local password accounts.
# deploy/compose.connected.yaml supports sign only, with passwords on.
# OBLETH_CHAT_GATEWAY_AUTH=sign
# 32 random bytes that encrypt saved connection tokens and, with forward, people's
# provider tokens. Raw, 64 hex characters or base64; make one with:
#   openssl rand -hex 32 > /absolute/path/to/obleth-chat-secret.key
# Saved connection tokens sealed with the signing key move to it while both are set.
# Adding it is one-way: without it, moved tokens can't be read.
# OBLETH_CHAT_SECRET_KEY_FILE=/absolute/path/to/obleth-chat-secret.key
# Optional public link shown only in Administration; no credentials here.
# OBLETH_CHAT_ADMIN_GATEWAY_URL=https://gateway-admin.example.edu

# Optional OIDC, additional to password login. Set all three together.
# Leave this entire block commented out when OIDC is disabled.
# OBLETH_CHAT_OIDC_ISSUER=https://idp.example.edu/realms/research
# OBLETH_CHAT_OIDC_CLIENT_ID=obleth-chat
# OBLETH_CHAT_OIDC_CLIENT_SECRET=
# OBLETH_CHAT_OIDC_ALLOW_SIGNUP=false
# true names accounts after the provider's preferred_username when it is free
# (otherwise oidc_<id>), and keeps those names current on each sign-in. Only for
# providers that assign usernames themselves and never reuse them. Default: false
# OBLETH_CHAT_OIDC_PROVIDER_USERNAMES=false
# Space-separated scopes to request; openid is always included. Default: openid profile
# OBLETH_CHAT_OIDC_SCOPES=openid profile email offline_access
# false closes every password path (sign-in, change, admin reset, invitations,
# reset links) and refuses to start with a bootstrap password. Needs OIDC; link
# existing administrators to their OIDC identity first. Default: true
# Not with deploy/compose.connected.yaml, which needs a bootstrap password.
# OBLETH_CHAT_PASSWORD_SIGN_IN=true
# Optional existing Chat group UUIDs for new local/OIDC accounts:
# OBLETH_CHAT_DEFAULT_GROUP_IDS=UUID,UUID
# Optional verified ID-token group mapping; no automatic administrator grants.
# OBLETH_CHAT_OIDC_GROUP_CLAIM=groups
# OBLETH_CHAT_OIDC_GROUP_MAP={"researchers":["CHAT_GROUP_UUID"]}

# 1-168 hours; up to 8760 with OBLETH_CHAT_GATEWAY_AUTH=forward, for sign-ins that
# keep a provider grant (password sessions stay capped at 168).
OBLETH_CHAT_SESSION_HOURS=12
# Sign-in requests per client per minute; failed attempts are also limited per account.
OBLETH_CHAT_LOGIN_RATE_PER_MINUTE=300
# Optional comma-separated reverse-proxy IPs or CIDRs whose X-Forwarded-For is trusted
# for per-client throttling; `loopback` covers a proxy on the same host. Never include
# client networks. Unset: throttle by the TCP peer address.
# Administration -> System -> Client address shows what Chat sees.
# OBLETH_CHAT_TRUSTED_PROXY=loopback
OBLETH_CHAT_MAX_STREAMS=128
# Attached files. Any file can be attached; text read whole stays at 256 KiB and
# images to view at 5 MiB. Largest file or document in MB (1-2000; at most 1000
# without object storage). Default: 50
# OBLETH_CHAT_MAX_FILE_MB=50
# One person's files in all, in MB. Default: 1024 with object storage (OBLETH_CHAT_S3_*),
# 200 without, when files are kept in Postgres.
# OBLETH_CHAT_FILE_QUOTA_MB=1024
# How many files one person may keep. Default: 500
# OBLETH_CHAT_MAX_FILES=500
OBLETH_CHAT_DB_CONNECTIONS=20
# Optional: when set, /metrics answers only requests with
# `Authorization: Bearer <token>`. Unset: /metrics is open, so restrict it at the proxy.
# OBLETH_CHAT_METRICS_TOKEN=
RUST_LOG=obleth_chat=info

# Compose only: generate separate URL-safe passwords with openssl rand -hex 32.
# OBLETH_CHAT_POSTGRES_PASSWORD=
# OBLETH_CHAT_POSTGRES_ADMIN_PASSWORD=

# Node design preview only (npm start); no live integrations.
# HOST=127.0.0.1
# PORT=4173

# Optional Kubernetes workspaces (see README "Workspaces").
# OBLETH_CHAT_SANDBOX_NAMESPACE=obleth-sandboxes
# OBLETH_CHAT_SANDBOX_IMAGE=registry.example/obleth-sandbox@sha256:...
# OBLETH_CHAT_PREVIEW_DOMAIN=sbx.example.com
# OBLETH_CHAT_SANDBOX_ACCESS=admins
# OBLETH_CHAT_SANDBOX_RUNTIME_CLASS=gvisor
# Optional browser for the model, alongside workspaces: one headless Chromium per
# person in the workspace namespace (image: deploy/browser/Dockerfile).
# OBLETH_CHAT_BROWSER_IMAGE=registry.example/obleth-browser@sha256:...
# OBLETH_CHAT_BROWSER_MEMORY=1Gi
# OBLETH_CHAT_BROWSER_IDLE_MINUTES=15
